/* 地图 Atom 组件样式 */

.map-atom {
  padding: 0;
}

.map-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  cursor: pointer;
}

.map-info:active {
  background-color: #eeeeee;
}

.map-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.map-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.location-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.location-desc {
  font-size: 28rpx;
  color: #666666;
  margin-top: 8rpx;
}

.map-arrow {
  font-size: 32rpx;
  color: #999999;
}
