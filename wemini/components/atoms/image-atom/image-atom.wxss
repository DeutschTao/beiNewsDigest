/* 图片 Atom 组件样式 */

.image-atom {
  padding: 0;
}

.image-scroll {
  width: 100%;
  white-space: nowrap;
}

.image-list {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.image-item {
  flex-shrink: 0;
  width: 280rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.image {
  width: 100%;
  height: 100%;
}

.image.hidden {
  opacity: 0;
}

.image-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
}

.placeholder-icon {
  font-size: 60rpx;
  opacity: 0.5;
}

.image-item:active {
  opacity: 0.8;
}
