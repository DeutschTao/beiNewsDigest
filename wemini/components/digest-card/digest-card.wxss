/* Digest 卡片组件样式 */

.digest-card {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 24rpx;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.card-bg.hidden {
  opacity: 0;
}

.card-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 100%);
}

.placeholder-icon {
  font-size: 120rpx;
  opacity: 0.6;
}

.card-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.2) 0%,
    rgba(0, 0, 0, 0.1) 30%,
    rgba(0, 0, 0, 0.7) 100%
  );
}

.card-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 48rpx;
}

.card-title-wrapper {
  margin-bottom: 16rpx;
}

.card-title {
  display: -webkit-box;
  -webkit-line-clamp: 7;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.card-meta {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card-source {
  font-weight: 500;
}

.card-dot {
  margin: 0 12rpx;
}

.card-time {
  color: rgba(255, 255, 255, 0.7);
}

/* 点击效果 */
.digest-card:active .card-bg {
  transform: scale(0.98);
}
