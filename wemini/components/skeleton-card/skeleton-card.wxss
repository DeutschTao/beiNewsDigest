/* 骨架屏卡片组件样式 */

.skeleton-card {
  width: 100%;
  height: 100%;
  padding: 32rpx;
  background: linear-gradient(135deg, #2a2a2a 0%, #3a3a3a 100%);
  border-radius: 24rpx;
}

/* 头部骨架 */
.skeleton-header {
  margin-bottom: 24rpx;
}

.skeleton-title {
  height: 48rpx;
  width: 70%;
  background: linear-gradient(90deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0.1) 100%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  animation: shimmer 1.5s infinite;
}

.skeleton-date {
  height: 28rpx;
  width: 40%;
  background: linear-gradient(90deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0.08) 100%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.5s infinite;
  animation-delay: 0.2s;
}

/* 封面图骨架 */
.skeleton-cover {
  flex: 1;
  min-height: 400rpx;
  margin: 24rpx 0;
}

.skeleton-image {
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0.08) 100%);
  background-size: 200% 100%;
  border-radius: 16rpx;
  animation: shimmer 1.5s infinite;
  animation-delay: 0.4s;
}

/* 底部骨架 */
.skeleton-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.skeleton-source {
  height: 32rpx;
  width: 30%;
  background: linear-gradient(90deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0.08) 100%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.5s infinite;
  animation-delay: 0.6s;
}

.skeleton-time {
  height: 28rpx;
  width: 20%;
  background: linear-gradient(90deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.15) 50%, rgba(255,255,255,0.08) 100%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.5s infinite;
  animation-delay: 0.8s;
}

/* 闪烁动画 */
@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
