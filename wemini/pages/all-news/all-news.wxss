/* 全部新闻列表页样式（v2 - 按源Tab分类展示） */

.all-news-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ffffff;
}

/* Tab 栏 */
.tab-bar {
  flex-shrink: 0;
  background-color: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.tab-scroll {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 24rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background-color: #f5f5f5;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #666666;
  transition: all 0.3s ease;
}

.tab-item.active {
  background-color: #333333;
  color: #ffffff;
  font-weight: 600;
}

.tab-text {
  font-size: 28rpx;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(51, 51, 51, 0.2);
  border-top-color: #333333;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 新闻列表 */
.news-list {
  height: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.news-item {
  display: flex;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: background-color 0.2s ease;
}

.news-item:active {
  background-color: #f5f5f5;
}

.news-item:last-child {
  border-bottom: none;
}

/* 缩略图 */
.item-thumb {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.item-thumb image {
  width: 100%;
  height: 100%;
}

.item-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
}

.thumb-placeholder-icon {
  font-size: 48rpx;
  opacity: 0.4;
}

/* 内容 */
.item-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.item-body.no-thumb {
  margin-left: 0;
}

.item-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.item-source {
  font-weight: 500;
  color: #666666;
}

/* 空状态 */
.empty-wrapper {
  padding: 100rpx 0;
}
.no-more {
  text-align: center;
  padding: 48rpx 32rpx;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}

.loading-text,
.load-text {
  font-size: 28rpx;
  color: #333333;
}

.no-more text {
  font-size: 28rpx;
  color: #999999;
}

/* Tab 内容区：Swiper */
.tab-swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.swiper-item-panel {
  height: 100%;
}

.swiper-item-panel .news-list {
  height: 100%;
  overflow-y: auto;
}
