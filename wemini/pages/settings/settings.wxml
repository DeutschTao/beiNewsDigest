<!-- 设置中心页 -->
<view class="settings-page">
  <!-- 内容 -->
  <scroll-view scroll-y class="settings-content">
    <!-- 推送通知卡片 -->
    <view class="push-card">
      <view class="card-header">
        <view class="header-left">
          <view class="icon-wrapper">
            <text>🔔</text>
          </view>
          <view class="header-info">
            <text class="card-title">推送通知</text>
            <text class="card-desc">接收新闻早晚报推送</text>
          </view>
        </view>
        <view 
          class="main-toggle {{pushEnabled ? 'on' : ''}}"
          bindtap="onTogglePush"
        >
          <view class="toggle-dot"></view>
        </view>
      </view>

      <!-- 推送选项 -->
      <view wx:if="{{pushEnabled}}" class="push-options">
        <view class="option-divider"></view>

        <!-- 早报 -->
        <view class="time-option {{morningEnabled ? 'active' : ''}}">
          <view class="option-left">
            <view class="time-icon morning">
              <text>🌅</text>
            </view>
            <view class="option-info">
              <text class="option-title">早报</text>
              <text class="option-time">{{morningTime}}</text>
            </view>
          </view>
          <view 
            class="toggle-switch {{morningEnabled ? 'on' : ''}}"
            bindtap="onToggleMorning"
          >
            <view class="switch-dot"></view>
          </view>
        </view>

        <!-- 晚报 -->
        <view class="time-option {{eveningEnabled ? 'active' : ''}}">
          <view class="option-left">
            <view class="time-icon evening">
              <text>🌙</text>
            </view>
            <view class="option-info">
              <text class="option-title">晚报</text>
              <text class="option-time">{{eveningTime}}</text>
            </view>
          </view>
          <view 
            class="toggle-switch {{eveningEnabled ? 'on' : ''}}"
            bindtap="onToggleEvening"
          >
            <view class="switch-dot"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 内容设置 -->
    <view class="settings-section">
      <text class="section-title">📰 内容设置</text>

      <view class="settings-card">
        <!-- 新闻源管理 -->
        <view class="setting-item" bindtap="onGoSources">
          <view class="item-left">
            <view class="item-icon">
              <text>📡</text>
            </view>
            <view class="item-info">
              <text class="item-title">新闻源管理</text>
              <text class="item-desc">添加或删除 RSS 订阅源</text>
            </view>
          </view>
          <view class="item-right">
            <text class="item-badge">{{enabledCount}}/{{totalCount}}</text>
            <text class="arrow">→</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 推送时间 -->
    <view wx:if="{{pushEnabled}}" class="settings-section">
      <text class="section-title">⏰ 推送时间</text>

      <view class="settings-card">
        <!-- 早报时间 -->
        <view wx:if="{{morningEnabled}}" class="setting-item" bindtap="onSelectMorningTime">
          <view class="item-left">
            <view class="item-icon morning">
              <text>🌅</text>
            </view>
            <view class="item-info">
              <text class="item-title">早报时间</text>
              <text class="item-desc">设置早间推送时间</text>
            </view>
          </view>
          <view class="item-right">
            <text class="item-value highlight">{{morningTime}}</text>
            <text class="arrow">→</text>
          </view>
        </view>

        <!-- 晚报时间 -->
        <view wx:if="{{eveningEnabled}}" class="setting-item" bindtap="onSelectEveningTime">
          <view class="item-left">
            <view class="item-icon evening">
              <text>🌙</text>
            </view>
            <view class="item-info">
              <text class="item-title">晚报时间</text>
              <text class="item-desc">设置晚间推送时间</text>
            </view>
          </view>
          <view class="item-right">
            <text class="item-value highlight">{{eveningTime}}</text>
            <text class="arrow">→</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 数据管理 -->
    <view class="settings-section">
      <text class="section-title">💾 数据管理</text>

      <view class="settings-card">
        <view class="setting-item" bindtap="onClearCache">
          <view class="item-left">
            <view class="item-icon">
              <text>🗑️</text>
            </view>
            <view class="item-info">
              <text class="item-title">清除缓存</text>
              <text class="item-desc">释放存储空间</text>
            </view>
          </view>
          <text class="arrow">→</text>
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="settings-section">
      <text class="section-title">ℹ️ 关于</text>

      <view class="about-card">
        <view class="about-logo">
          <text>📰</text>
        </view>
        <view class="about-info">
          <text class="about-name">Bei News Digest</text>
          <text class="about-version">版本 1.0.0</text>
        </view>
      </view>
    </view>

    <!-- 重置按钮 -->
    <view class="reset-section">
      <view class="reset-btn" bindtap="onResetSettings">
        <text>↻</text>
        <text>重置所有设置</text>
      </view>
    </view>
  </scroll-view>

  <!-- 时间选择器 -->
  <view wx:if="{{showTimePicker}}" class="time-picker-mask" bindtap="onTimeCancel">
    <view class="time-picker-panel" catchtap="noop">
      <view class="picker-header">
        <text class="picker-cancel" bindtap="onTimeCancel">取消</text>
        <text class="picker-title">选择时间</text>
        <text class="picker-confirm" bindtap="onTimeConfirm">确认</text>
      </view>
      <picker-view
        class="picker-view"
        value="{{pickerValue}}"
        bindchange="onTimeChange"
      >
        <picker-view-column>
          <view wx:for="{{hours}}" wx:key="*this" class="picker-item">{{item}}</view>
        </picker-view-column>
        <picker-view-column>
          <view class="picker-separator">:</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{minutes}}" wx:key="*this" class="picker-item">{{item}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
</view>
