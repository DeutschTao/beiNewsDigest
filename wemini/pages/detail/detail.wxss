/* 新闻详情页样式 */

.detail-page {
  height: 100vh;
  height: 100dvh;
  background-color: #ffffff;
}

.detail-page-inner {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.detail-scroll {
  flex: 1;
  overflow-y: auto;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  gap: 32rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(51, 51, 51, 0.2);
  border-top-color: #333333;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666666;
}

/* 错误状态 */
.error-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

/* 封面图 */
.cover-section {
  position: relative;
  height: 50vh;
  min-height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 100%);
}

.placeholder-img {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 150rpx;
  background: linear-gradient(to top, #ffffff 0%, transparent 100%);
}

/* 新闻头部 */
.news-header {
  padding: 0 32rpx;
  margin-top: -80rpx;
  position: relative;
  z-index: 10;
}

.news-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
  margin-bottom: 24rpx;
}

.news-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #666666;
}

.news-source {
  font-weight: 500;
}

.meta-dot {
  color: #999999;
}

/* 内容区域 */
.content-section {
  padding: 32rpx;
}

.content-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.label-icon {
  font-size: 32rpx;
}

.label-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.fetched-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: rgba(76, 217, 100, 0.15);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #4cd964;
  margin-left: 16rpx;
  font-weight: normal;
}

.content-body {
  border-radius: 16rpx;
  padding: 32rpx;
}

.content-text {
  font-size: 32rpx;
  color: #333333;
  line-height: 1.8;
}

/* 原文链接（固定底部） */
.original-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
  flex-shrink: 0;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.original-link:active {
  background-color: #f5f5f5;
}

.link-icon {
  font-size: 36rpx;
}

.link-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.link-arrow {
  font-size: 28rpx;
  color: #999999;
}
