<!-- 新闻详情页 -->
<view class="detail-page">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载...</text>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="error-container">
    <empty-state
      type="error"
      title="加载失败"
      description="{{error}}"
      showAction="{{true}}"
      actionText="重试"
      bind:action="loadNewsDetail"
    />
  </view>

  <!-- 内容 -->
  <view wx:else class="detail-page-inner">
    <!-- 可滚动内容区域 -->
    <scroll-view scroll-y class="detail-scroll">
      <!-- 封面图 -->
      <view class="cover-section">
        <image
          wx:if="{{detail.coverImage && !coverError}}"
          class="cover-image"
          src="{{detail.coverImage}}"
          mode="aspectFill"
          binderror="onCoverError"
          bindtap="onPreviewCover"
        ></image>
        <view wx:else class="cover-placeholder">
          <image class="placeholder-img" src="https://static.youngtao.wang/assets/images/placeholder2.png" mode="aspectFill"></image>
        </view>
        <view class="cover-overlay"></view>
      </view>

      <!-- 新闻头部 -->
      <view class="news-header">
        <text class="news-title">{{detail.title}}</text>
        <view class="news-meta">
          <text class="news-source">{{detail.source}}</text>
          <text class="meta-dot">·</text>
          <text class="news-time">{{formattedTime}}</text>
        </view>
      </view>

      <!-- 内容区 -->
      <view class="content-section">
        <view class="content-label">
          <text class="label-icon">{{detail.hasFullContent ? '📄' : '📝'}}</text>
          <text class="label-text">
            <text>{{detail.hasFullContent ? '原文内容' : '摘要'}}</text>
            <text wx:if="{{detail.hasFullContent}}" class="fetched-tag">实时抓取</text>
          </text>
        </view>

        <!-- 有全文时渲染 rich-text -->
        <rich-text
          wx:if="{{detail.hasFullContent && detail.contentHtml}}"
          nodes="{{detail.contentHtml}}"
          class="content-body"
        />

        <!-- 无全文时展示摘要 -->
        <view wx:else class="content-body">
          <text class="content-text">{{detail.summary || '暂无内容'}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 原文链接（固定在底部） -->
    <view class="original-link" bindtap="onOpenOriginal">
      <text class="link-icon">🔗</text>
      <text class="link-text">查看原文链接</text>
      <text class="link-arrow">→</text>
    </view>
  </view>
</view>
