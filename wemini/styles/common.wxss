/*通用样式*/

/*页面容器*/
.page-container {
  width: 100%;
  min-height: 100vh;
  background-color: #ffffff;
}

/*通用卡片*/
.common-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

/*按钮点击效果*/
.btn-active:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/*分割线*/
.divider {
  width: 100%;
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.05);
}

.divider-dark {
  width: 100%;
  height: 1rpx;
  background-color: rgba(255, 255, 255, 0.1);
}

/*空状态容器*/
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 50rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 48rpx;
}

/*加载状态*/
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

/*深色页面头部*/
.dark-header {
  background: linear-gradient(135deg, #1a1a1a 0%, #333333 100%);
  padding: 48rpx 32rpx;
  padding-top: calc(48rpx + constant(safe-area-inset-top));
  padding-top: calc(48rpx + env(safe-area-inset-top));
}

.dark-header-content {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.dark-header-title {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: -1rpx;
}

.dark-header-back {
  font-size: 44rpx;
  color: #ffffff;
}

/*列表项通用样式*/
.list-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: background-color 0.2s ease;
}

.list-item:active {
  background-color: #f5f5f5;
}

.list-item:last-child {
  border-bottom: none;
}

/*表单样式*/
.form-section {
  padding: 32rpx;
}

.form-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

/*图标按钮*/
.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.15);
  color: #ffffff;
  font-size: 36rpx;
  transition: all 0.2s ease;
}

.icon-btn:active {
  transform: scale(0.9);
  background-color: rgba(255, 255, 255, 0.25);
}

/*开关样式覆盖*/
.van-switch {
  --van-switch-size: 44rpx;
}

.van-switch--on {
  --van-switch-background-color: #333333;
}
