/*主题变量 - 保持与 H5 版本一致*/

/*主题色*/
.theme-color {
  color: #333333;
}

/*背景色*/
.bg-primary {
  background-color: #ffffff;
}

.bg-secondary {
  background-color: #f5f5f5;
}

.bg-dark {
  background-color: #1a1a1a;
}

.bg-card {
  background-color: #ffffff;
}

/*文字色*/
.text-primary {
  color: #1a1a1a;
}

.text-secondary {
  color: #666666;
}

.text-tertiary {
  color: #999999;
}

.text-inverse {
  color: #ffffff;
}

/*功能色*/
.red {
  color: #ee0a24;
}

.orange {
  color: #ff976a;
}

/*渐变背景*/
.gradient-bg {
  background: linear-gradient(135deg, #1a1a1a 0%, #333333 100%);
}

.gradient-card {
  background: linear-gradient(135deg, #333333 0%, #4a4a4a 100%);
}

/*字体大小*/
.font-xs { font-size: 24rpx; }
.font-sm { font-size: 28rpx; }
.font-base { font-size: 32rpx; }
.font-lg { font-size: 36rpx; }
.font-xl { font-size: 40rpx; }
.font-xxl { font-size: 48rpx; }

/*间距*/
.spacing-xs { padding: 8rpx; }
.spacing-sm { padding: 16rpx; }
.spacing-base { padding: 32rpx; }
.spacing-lg { padding: 48rpx; }
.spacing-xl { padding: 64rpx; }

/*圆角*/
.radius-sm { border-radius: 8rpx; }
.radius-base { border-radius: 16rpx; }
.radius-lg { border-radius: 24rpx; }
.radius-xl { border-radius: 32rpx; }
.radius-full { border-radius: 9999rpx; }

/*阴影*/
.shadow-sm {
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.shadow-base {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.shadow-lg {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

/*动画时长*/
.duration-fast { transition: all 0.15s ease; }
.duration-base { transition: all 0.3s ease; }
.duration-slow { transition: all 0.5s ease; }
